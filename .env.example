# Copy to .env and fill in real values. .env is git-ignored.

# Kafka
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
SCHEMA_REGISTRY_URL=http://localhost:8081

# Market data APIs
ALPHA_VANTAGE_API_KEY=
COINGECKO_API_KEY=
# Live US stock trades over websocket (free key: https://finnhub.io/register)
FINNHUB_API_KEY=

# Warehouse (local PostgreSQL)
# Matches infra/.env (POSTGRES_USER / POSTGRES_PASSWORD / POSTGRES_HOST_PORT).
WAREHOUSE_URL=postgresql+psycopg://market:password@localhost:5433/market
BACKEND_DATABASE_URL=postgresql+psycopg://backend:password@localhost:5433/backend
# The API reads the warehouse through a read-only role (warehouse/ddl/05_api_reader.sql).
API_READER_PASSWORD=change-me
WAREHOUSE_READONLY_URL=postgresql+psycopg://api_reader:change-me@localhost:5433/market

# Backend auth. The API refuses to start with a placeholder or short secret:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=change-me
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Backend rate limits (requests per minute)
RATE_LIMIT_DATA_PER_MINUTE=60       # per logged-in user
RATE_LIMIT_LOGIN_PER_MINUTE=10      # per client IP
RATE_LIMIT_REGISTER_PER_MINUTE=5    # per client IP

# Dashboard (read from the environment when you run `streamlit run app.py`; default shown)
# API_BASE_URL=http://127.0.0.1:8000
