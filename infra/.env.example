# Secrets and settings for the local Docker stack (infra/).
#
#   cp infra/.env.example infra/.env     # then replace every change-me
#
# infra/.env is git-ignored. Compose fails fast with a clear message if a
# required value is missing, rather than starting with an empty password.
#
# This file is the local stand-in for a secrets manager. In AWS these values
# would live in Secrets Manager / SSM Parameter Store and be injected at
# runtime, never written to disk on a developer laptop.

# --- Warehouse PostgreSQL (infra/docker-compose.yml) ------------------------
POSTGRES_USER=market
POSTGRES_PASSWORD=change-me
POSTGRES_DB=market

# --- Backend app database (same Postgres server, separate db + role) --------
BACKEND_DB_NAME=backend
BACKEND_DB_USER=backend
BACKEND_DB_PASSWORD=change-me

# --- Airflow metadata DB (infra/airflow/docker-compose.yml) -----------------
AIRFLOW_DB_USER=airflow
AIRFLOW_DB_PASSWORD=change-me

# --- Airflow admin login for the UI -----------------------------------------
AIRFLOW_ADMIN_USERNAME=admin
AIRFLOW_ADMIN_PASSWORD=change-me

# --- Airflow crypto keys ------------------------------------------------------
# Fernet key encrypts connection passwords in the metadata DB. Generate ONCE
# and keep it: changing it makes stored secrets unreadable.
#   python -c "import base64, os; print(base64.urlsafe_b64encode(os.urandom(32)).decode())"
AIRFLOW_FERNET_KEY=
# Shared by all Airflow components to sign/verify internal JWTs and sessions.
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
AIRFLOW_JWT_SECRET=
AIRFLOW_API_SECRET_KEY=

# Linux/macOS: set to the output of `id -u` so files Airflow writes into
# orchestration/logs are owned by you. On Windows (Docker Desktop) leave 50000.
AIRFLOW_UID=50000

# --- Host ports (all bound to 127.0.0.1) ------------------------------------
# Change these if something on your machine already uses the port.
KAFKA_HOST_PORT=9092
SCHEMA_REGISTRY_HOST_PORT=8081
KAFKA_UI_HOST_PORT=8085
POSTGRES_HOST_PORT=5433
AIRFLOW_API_HOST_PORT=8080
AIRFLOW_FLOWER_HOST_PORT=5555
